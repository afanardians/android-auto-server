<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header with App Logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_launcher"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginLeft="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Android Auto Server"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Head Unit Server Controller v1.5.0"
                    android:textSize="12sp"
                    android:textColor="#64748B" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card 1: Server Realtime Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS HEAD UNIT SERVER"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Memeriksa status..."
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#64748B" />

            <TextView
                android:id="@+id/tv_status_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Menghubungkan ke port server lokal..."
                android:textSize="12sp"
                android:textColor="#64748B"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Card 2: Master Power Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/card_bg"
            android:padding="22dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="KONTROL POWER SERVER"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:layout_marginBottom="16dp" />

            <ImageButton
                android:id="@+id/btn_power_toggle"
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:src="@drawable/ic_power_on"
                android:scaleType="fitCenter"
                android:background="@null"
                android:contentDescription="Power Toggle Button" />

            <TextView
                android:id="@+id/tv_toggle_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 SERVER MATI — Ketuk untuk Menyalakan"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#DC2626"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <!-- Card 3: Bluetooth Automation Configuration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OTOMASI BLUETOOTH MOBIL"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:layout_marginBottom="10dp" />

            <CheckBox
                android:id="@+id/cb_auto_bt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Otomatis Nyalakan saat Terhubung ke Mobil"
                android:checked="true"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih Perangkat Bluetooth Head Unit / Mobil:"
                android:textSize="12sp"
                android:textColor="#64748B"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/sp_bluetooth"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/spinner_bg"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_target_bt_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Target Terpilih: Rush"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#0284C7" />
        </LinearLayout>

        <!-- Card 4: Home Screen Widget Integration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WIDGET LAYAR UTAMA (HOMESCREEN)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gunakan widget di layar depan untuk mengontrol server secara instan satu-sentuhan kapan saja."
                android:textSize="12sp"
                android:textColor="#64748B"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_pin_widget"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="📲 Pasang Widget ke Layar Depan"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_primary_bg" />
        </LinearLayout>

        <!-- Card 5: Log Console -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="18dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOG AKTIVITAS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_log"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/log_bg"
                android:padding="10dp"
                android:text="Android Auto Server v1.3.0 siap.\nGunakan tombol toggle di atas untuk kontrol server."
                android:textColor="#334155"
                android:textSize="12sp"
                android:scrollbars="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
